{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "itpath-builder",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public"
  },
  "observability": {
    "enabled": true
  },
  "vars": {}
}