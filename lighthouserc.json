{
  "ci": {
    "collect": {
      "startServerCommand": "node node_modules/wrangler/bin/wrangler.js dev dist/server/index.mjs --assets dist/client --compatibility-date 2026-09-24 --compatibility-flags nodejs_compat --ip 127.0.0.1 --port 4173",
      "startServerReadyPattern": "Ready on",
      "startServerReadyTimeout": 180000,
      "numberOfRuns": 2,
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/guides",
        "http://127.0.0.1:4173/guides/computer-hardware-basics",
        "http://127.0.0.1:4173/pricing",
        "http://127.0.0.1:4173/auth"
      ],
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "color-contrast": "error",
        "heading-order": "warn",
        "html-has-lang": "error",
        "image-alt": "error",
        "label": "error",
        "link-name": "error",
        "meta-description": "error",
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 3000 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 400 }],
        "unused-javascript": "off",
        "uses-responsive-images": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
